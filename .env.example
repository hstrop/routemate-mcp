# auto: 有 DASHSCOPE_API_KEY 时启用在线 Agent，否则使用确定性离线演示
ROUTEMATE_MODE=auto

# 仅通过环境变量注入真实密钥；不要把密钥提交到仓库
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen-plus

# 天气 MCP：不填时返回带 offline_demo 标记的固定演示数据
OPENWEATHER_API_KEY=
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5/weather

# 文件 MCP 只能写入该目录，支持 .txt/.md/.json，单次最大 100 KiB
ROUTEMATE_OUTPUT_DIR=./runtime_output

# 可选：复制 servers_config.example.json 后填写其路径
# MCP_SERVERS_CONFIG=./servers_config.example.json

# 可选高德地图 MCP。示例配置默认 disabled，不会连接远程服务
AMAP_MCP_SSE_URL=
AMAP_MCP_STREAMABLE_URL=
AMAP_MCP_TOKEN=

# HTTP 服务
ROUTEMATE_HOST=127.0.0.1
ROUTEMATE_PORT=8000

